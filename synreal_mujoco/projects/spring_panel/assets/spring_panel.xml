            <geom name="holder_left" type="box" pos="-0.285 0 0.24"
                  size="0.03 0.24 0.18" rgba="0.25 0.45 0.65 1"/>
            <geom name="holder_right" type="box" pos="0.285 0 0.24"
                  size="0.03 0.24 0.18" rgba="0.25 0.45 0.65 1"/>
        </body>
        <body name="panel" pos="0 0 0.8">
            <freejoint name="panel_free"/>
            <geom name="panel" type="box" size="0.25 0.18 0.04"
                  mass="1" rgba="0.95 0.55 0.15 1"/>
        </body>
    </worldbody>
</mujoco>
