<mujoco model="spring_panel">
    <compiler angle="radian"/>
    <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

    <visual>
        <headlight ambient="0.4 0.4 0.4" diffuse="0.7 0.7 0.7"/>
    </visual>

    <default>
        <geom friction="0.8 0.01 0.001" condim="3" solref="0.005 1"/>
    </default>

    <worldbody>
        <light pos="0 -1 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" pos="0 0 0" size="0.8 0.8 0.05"
              rgba="0.35 0.4 0.45 1"/>
    </worldbody>
</mujoco>
